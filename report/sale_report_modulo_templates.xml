<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_saleorder_document_laser_modulo">
        <t t-call="web.external_layout">
            <link rel="stylesheet" type="text/css" href="/lasercom_2_13/static/src/css/custom.css"/>

            <div class="page custom-mt12">
                <div class="oe_structure"/>

                <div class="row m-0 mb32" id="informations">
                    <div class="col-auto mw-100 mb-2" style="text-align:left; white-space: nowrap;">
                        <strong>Preventivo:</strong>
                        <span t-field="doc.name"/>
                    </div>
                    <div t-if="doc.date_order" class="col-auto mw-100 mb-2">
                        <strong>Data:</strong>
                        <p class="m-0" t-field="doc.date_order" t-options="{&quot;widget&quot;: &quot;date&quot;}"/>
                    </div>
                    <div t-if="doc.user_id.name" class="col-auto mw-100 mb-2">
                        <strong>Venditore:</strong>
                        <p class="m-0" t-field="doc.user_id"/>
                    </div>
                    <div class="col-auto mw-100 mb-2">
                        <strong>Cliente:</strong>
                        <p class="m-0" t-field="doc.partner_id.name"/>
                    </div>
                    <t t-set="address">
                        <div t-field="doc.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: True}"/>
                    </t>
                </div>

                <div class="row m-0 mb32" id="informations_modulo">
                    <div t-if="doc.date_module" class="col-auto mw-100 mb-2">
                        <strong>Consegna Richiesta dal Cliente:</strong>
                        <p class="m-0" t-field="doc.date_module" t-options="{&quot;widget&quot;: &quot;date&quot;}"/>
                    </div>
                    <div t-if="doc.date_module_display" class="col-auto mw-100 mb-2">
                        <strong>Mese previsto per la consegna:</strong>
                        <p class="m-0" t-field="doc.date_module_display"/>
                    </div>
                    <div t-if="doc.date_installation" class="col-auto mw-100 mb-2">
                        <strong>Installazione prevista il:</strong>
                        <p class="m-0" t-field="doc.date_installation" t-options="{&quot;widget&quot;: &quot;date&quot;}"/>
                    </div>
                    <div t-if="doc.date_installation_display" class="col-auto mw-100 mb-2">
                        <strong>Mese previsto per l'installazione:</strong>
                        <p class="m-0" t-field="doc.date_installation_display"/>
                    </div>
                    <div t-if="doc.price_aggiunt_inst" class="col-auto mw-100 mb-2">
                        <strong>Costo aggiuntivo installazione:</strong>
                        <p class="m-0" t-field="doc.price_aggiunt_inst" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}"/>
                    </div>
                    <div t-if="doc.sale_acq_usage &gt; 0" class="col-auto mw-100 mb-2">
                        <strong>Acquisto usato:</strong>
                        <p class="m-0" t-field="doc.sale_acq_usage" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}"/>
                    </div>
                    <div t-if="doc.sale_val_usage &gt; 0" class="col-auto mw-100 mb-2">
                        <strong>Valutazione usato:</strong>
                        <p class="m-0" t-field="doc.sale_val_usage" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}"/>
                    </div>
                </div>

                <div t-if="doc.note_modulo_installazione" class="alert alert-info mt-2" role="alert">
                    <strong>Note installazione:</strong>
                    <p class="m-0" t-field="doc.note_modulo_installazione"/>
                </div>
                <div t-if="doc.note_modulo_agente" class="alert alert-info mt-2" role="alert">
                    <strong>Note agente:</strong>
                    <p class="m-0" t-field="doc.note_modulo_agente"/>
                </div>

                <h3>Modulo Installazione</h3>

                <t t-set="modulo_lines" t-value="doc.x_load_line_ids.filtered(lambda l: not l.display_type and l.etichetta_si == 'yes' and l.product_uom_qty)"/>
                <t t-set="modulo_total" t-value="sum(modulo_lines.mapped('price_subtotal'))"/>

                <div class="row m-0 mb32 avoid-page-break" id="dettaglio">
                    <table class="table table-sm o_main_table avoid-page-break">
                        <thead>
                            <tr>
                                <th name="th_description" class="text-left bordo-inferiore">Descrizione</th>
                                <th name="th_quantity" class="text-right bordo-inferiore">Quantità</th>
                                <th name="th_priceunit" class="text-right bordo-inferiore">Prezzo Unitario</th>
                                <th name="th_subtotal" class="text-right bordo-inferiore">Totale riga</th>
                            </tr>
                        </thead>
                        <tbody class="sale_tbody">
                            <tr t-foreach="modulo_lines" t-as="line">
                                <td name="td_name">
                                    <span t-if="line.product_id" t-esc="line.product_id.display_name"/>
                                    <span t-if="not line.product_id" t-field="line.name"/>
                                </td>
                                <td name="td_quantity" class="text-right">
                                    <span t-field="line.product_uom_qty"/>
                                </td>
                                <td name="td_priceunit" class="text-right">
                                    <span t-field="line.price_unit" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}"/>
                                </td>
                                <td name="td_subtotal" class="text-right">
                                    <span t-field="line.price_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}"/>
                                </td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr class="border-black">
                                <td colspan="3" class="text-right"><strong>Totale</strong></td>
                                <td class="text-right">
                                    <strong>
                                        <span t-esc="modulo_total" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}"/>
                                    </strong>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </t>
    </template>

    <template id="report_saleorder_laser_modulo">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="lasercom_2_13.report_saleorder_document_laser_modulo" t-lang="doc.partner_id.lang">
                    <t t-set="company" t-value="doc.company_id"/>
                </t>
            </t>
        </t>
    </template>

</odoo>
