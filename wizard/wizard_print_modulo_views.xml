<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_print_modulo_wizard_form" model="ir.ui.view">
        <field name="name">x.sale.order.print.modulo.wizard.form</field>
        <field name="model">x.sale.order.print.modulo.wizard</field>
        <field name="arch" type="xml">
            <form string="Stampa Modulo Installazione">
                <group>
                    <field name="order_id" readonly="1"/>
                    <field name="sort_field"/>
                    <field name="sort_desc" attrs="{'invisible': [('sort_field','=','module')]}"/>
                    <field name="print_supplier"/>
                </group>
                <div class="text-muted" attrs="{'invisible': [('sort_field','=','module')]}">
                    Con questo ordinamento le Sezioni non vengono stampate.
                </div>
                <footer>
                    <button string="Stampa" type="object" name="action_print" class="btn-primary"/>
                    <button string="Annulla" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_print_modulo_wizard" model="ir.actions.act_window">
        <field name="name">Stampa Modulo Installazione</field>
        <field name="res_model">x.sale.order.print.modulo.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
